# AYAN Platform - Environment Configuration
# Copy this file to .env and fill in the required values.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ayan"
DIRECT_URL="postgresql://user:password@localhost:5432/ayan"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-strong-secret"

# Google OAuth (optional)
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Stripe (optional)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (optional)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@ayan.example.com"

# File storage (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Application
APP_URL="http://localhost:3000"
APP_NAME="AYAN"
SUPPORT_EMAIL="support@ayan.example.com"

# Rate limiting
RATE_LIMIT_DISABLED="false"

# Sentry (optional)
SENTRY_DSN=""